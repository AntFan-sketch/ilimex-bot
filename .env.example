# OpenAI (server-side only)
OPENAI_API_KEY=
OPENAI_PUBLIC_MODEL=gpt-5.6-luna
OPENAI_INTERNAL_MODEL=gpt-5.6-luna
# Legacy compatibility only; OPENAI_PUBLIC_MODEL / OPENAI_INTERNAL_MODEL take precedence.
ILIMEX_OPENAI_MODEL=

# PostgreSQL / Neon (server-side only)
DATABASE_URL=
# Keep certificate verification enabled for managed providers such as Neon.
# Set false only for a known legacy/private PostgreSQL server with a self-signed certificate.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Admin and cron authentication (server-side only)
# Use separate, high-entropy values. Never prefix these with NEXT_PUBLIC_.
ADMIN_DASH_TOKEN=
CRON_SECRET=

# Website enquiry email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
TO_EMAIL=

# Optional analytics
ILIMEX_ANALYTICS_ENABLED=false
ILIMEX_ANALYTICS_SAMPLE_RATE=0.25
